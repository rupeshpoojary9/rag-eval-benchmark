# RAG Eval Benchmark - gold set (40 questions).
# Each answer snippet is copied from a corpus doc and resolved to a char span at load
# time (whitespace-insensitive). phrasing: verbatim | paraphrase | synonym.
# Questions are deliberately skewed toward paraphrase/synonym user phrasing so the
# benchmark discriminates lexical (BM25) from semantic (dense/hybrid) retrieval.
{"id": "q01", "question": "how can search still work when the question and the answer use completely different words?", "answers": [{"doc": "dense-retrieval", "snippet": "match a question to an answer even when they share no words"}], "phrasing": "synonym", "difficulty": "medium"}
{"id": "q02", "question": "what makes searching every vector too slow, and what fixes it at scale?", "answers": [{"doc": "dense-retrieval", "snippet": "production systems use approximate nearest neighbour (ANN) search"}, {"doc": "vector-databases", "snippet": "Approximate nearest neighbour (ANN) indexes make search sublinear"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q03", "question": "why should I scale my vectors to unit length before comparing them?", "answers": [{"doc": "dense-retrieval", "snippet": "Embeddings should generally be L2-normalised before comparison"}], "phrasing": "synonym", "difficulty": "hard"}
{"id": "q04", "question": "when is it fine to just compare against every vector instead of building an index?", "answers": [{"doc": "dense-retrieval", "snippet": "an exact brute-force scan over all vectors is simpler and fast enough"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q05", "question": "what is BM25 and what three things does it score a passage on?", "answers": [{"doc": "sparse-retrieval-bm25", "snippet": "how often each query term appears in the passage (term\nfrequency), how rare that term is across the whole collection (inverse document\nfrequency), and how long the passage is relative to the\naverage"}], "phrasing": "verbatim", "difficulty": "easy"}
{"id": "q06", "question": "why does keyword search miss a passage that means the same thing but is worded differently?", "answers": [{"doc": "sparse-retrieval-bm25", "snippet": "the vocabulary mismatch problem"}], "phrasing": "synonym", "difficulty": "medium"}
{"id": "q07", "question": "what is BM25 unusually good at compared to embeddings?", "answers": [{"doc": "sparse-retrieval-bm25", "snippet": "The great advantage of BM25 is precision on exact terms"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q08", "question": "what do the k1 and b constants actually control in BM25?", "answers": [{"doc": "sparse-retrieval-bm25", "snippet": "k1 and b, control term-frequency\nsaturation and the strength of length normalisation"}], "phrasing": "verbatim", "difficulty": "easy"}
{"id": "q09", "question": "what is the point of combining keyword and embedding search together?", "answers": [{"doc": "hybrid-search", "snippet": "the two methods make uncorrelated mistakes"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q10", "question": "how does reciprocal rank fusion combine two result lists?", "answers": [{"doc": "hybrid-search", "snippet": "Every passage receives a\ncontribution of one divided by a small constant k plus its rank"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q11", "question": "why do people prefer RRF over adding up the raw scores?", "answers": [{"doc": "hybrid-search", "snippet": "it needs no score normalisation, is robust to scale mismatches"}], "phrasing": "paraphrase", "difficulty": "hard"}
{"id": "q12", "question": "what does the alpha weight do when I fuse scores directly?", "answers": [{"doc": "hybrid-search", "snippet": "alpha, controls how much the dense signal counts relative to the sparse signal"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q13", "question": "what is the difference between a two-tower model and one that reads both texts at once?", "answers": [{"doc": "reranking", "snippet": "A\ncross-encoder instead feeds the query and a candidate passage together into a single\ntransformer"}], "phrasing": "synonym", "difficulty": "hard"}
{"id": "q14", "question": "why can't I just run the cross-encoder over the whole collection?", "answers": [{"doc": "reranking", "snippet": "it is far too slow to score an entire\ncorpus"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q15", "question": "if the correct passage was never retrieved, can a reranker save me?", "answers": [{"doc": "reranking", "snippet": "If the right\npassage is not retrieved at all, a reranker cannot help"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q16", "question": "how many candidates does a reranker usually reorder?", "answers": [{"doc": "reranking", "snippet": "typically the top twenty to one\nhundred candidates"}], "phrasing": "verbatim", "difficulty": "easy"}
{"id": "q17", "question": "what happens to answer quality if the passages I break my documents into are too big?", "answers": [{"doc": "chunking-strategies", "snippet": "Large chunks preserve context\nand reduce the risk of splitting an answer, but they dilute the embedding"}], "phrasing": "synonym", "difficulty": "hard"}
{"id": "q18", "question": "is there a way to get both precise matching and full context when splitting documents?", "answers": [{"doc": "chunking-strategies", "snippet": "Small child\nchunks are embedded and retrieved for precision, but when one is matched the system\nreturns its larger parent section"}], "phrasing": "paraphrase", "difficulty": "hard"}
{"id": "q19", "question": "what does adding overlap between passages cost me?", "answers": [{"doc": "chunking-strategies", "snippet": "Overlap softens boundary\neffects but inflates the index with near-duplicate content"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q20", "question": "does the leaderboard tell me which embedding model to pick for my data?", "answers": [{"doc": "embedding-models", "snippet": "a model that tops a general benchmark can\nstill underperform on a specific domain"}], "phrasing": "paraphrase", "difficulty": "hard"}
{"id": "q21", "question": "some models want a little instruction attached to the query, right?", "answers": [{"doc": "embedding-models", "snippet": "Many modern models expect a task-specific instruction or prefix on the query"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q22", "question": "what is HNSW?", "answers": [{"doc": "vector-databases", "snippet": "HNSW, a\nlayered proximity graph that navigates from coarse to fine"}], "phrasing": "verbatim", "difficulty": "easy"}
{"id": "q23", "question": "how do I add vector search to a Postgres database?", "answers": [{"doc": "vector-databases", "snippet": "the pgvector\nextension that adds vector types and indexes to PostgreSQL"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q24", "question": "when should I care about MRR instead of recall?", "answers": [{"doc": "retrieval-metrics", "snippet": "MRR is the metric to watch when only the top result really matters"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q25", "question": "how is mean reciprocal rank computed for a single query?", "answers": [{"doc": "retrieval-metrics", "snippet": "it takes the reciprocal of the rank of the first relevant\nresult"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q26", "question": "which retrieval metric ignores position and only asks if the answer is in the top results?", "answers": [{"doc": "retrieval-metrics", "snippet": "It cares only about presence within the cutoff, not\nposition"}], "phrasing": "paraphrase", "difficulty": "hard"}
{"id": "q27", "question": "can an answer be faithful to the sources but still wrong?", "answers": [{"doc": "faithfulness-groundedness", "snippet": "An answer can be faithful to the context yet\nwrong because the retrieved passage was itself wrong or outdated"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q28", "question": "how do I stop the model from making things up that aren't in the sources?", "answers": [{"doc": "faithfulness-groundedness", "snippet": "improving retrieval so the\nanswer is actually present in the context is often the most effective way to reduce\nhallucination"}, {"doc": "prompt-engineering-rag", "snippet": "The foundational instruction is to answer only from the provided context"}], "phrasing": "synonym", "difficulty": "hard"}
{"id": "q29", "question": "how is a groundedness score actually calculated?", "answers": [{"doc": "faithfulness-groundedness", "snippet": "decomposing the answer into individual claims and\nchecking each against the retrieved context"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q30", "question": "what is the hardest part of evaluating retrieval, and why do most teams skip it?", "answers": [{"doc": "rag-evaluation", "snippet": "a collection of questions paired with the passages that genuinely answer them"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q31", "question": "why label relevance by text span rather than by chunk id?", "answers": [{"doc": "rag-evaluation", "snippet": "Labelling by character span within a document, rather than\nby chunk id, keeps the gold set valid when the chunking configuration changes"}], "phrasing": "paraphrase", "difficulty": "hard"}
{"id": "q32", "question": "what is the difference between testing on a fixed set and watching real user behaviour?", "answers": [{"doc": "rag-evaluation", "snippet": "Offline evaluation runs the\nfixed gold set through the pipeline"}, {"doc": "rag-evaluation", "snippet": "Online evaluation observes real traffic"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q33", "question": "why does burying a relevant passage in the middle of the context hurt?", "answers": [{"doc": "context-window-management", "snippet": "an effect often described as \"lost in the middle.\""}], "phrasing": "synonym", "difficulty": "hard"}
{"id": "q34", "question": "does feeding the model more passages always improve the answer?", "answers": [{"doc": "context-window-management", "snippet": "More context is therefore not automatically better"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q35", "question": "should I retrain the model or use retrieval when my facts keep changing?", "answers": [{"doc": "rag-vs-finetuning", "snippet": "ideal for information that changes\noften"}], "phrasing": "synonym", "difficulty": "hard"}
{"id": "q36", "question": "when is adjusting the model's weights the right call instead of retrieval?", "answers": [{"doc": "rag-vs-finetuning", "snippet": "Fine-tuning is the right tool when the challenge is behaviour"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q37", "question": "what is HyDE and why would writing a fake answer help retrieval?", "answers": [{"doc": "query-transformation", "snippet": "hypothetical document embedding, or HyDE, which asks a language\nmodel to draft a hypothetical answer"}], "phrasing": "verbatim", "difficulty": "easy"}
{"id": "q38", "question": "how do I get the model to admit it doesn't know instead of guessing?", "answers": [{"doc": "prompt-engineering-rag", "snippet": "an abstention instruction: the\nmodel should say it does not know"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q39", "question": "what is prompt injection through retrieved documents?", "answers": [{"doc": "guardrails-and-injection", "snippet": "Indirect injection,\narriving through retrieved or tool-fetched content"}], "phrasing": "paraphrase", "difficulty": "medium"}
{"id": "q40", "question": "how does the number of passages I retrieve affect what I pay per request?", "answers": [{"doc": "tokenization-and-cost", "snippet": "the retrieval cutoff k, the chunk size, and any overlap translate straight into money"}], "phrasing": "synonym", "difficulty": "hard"}
